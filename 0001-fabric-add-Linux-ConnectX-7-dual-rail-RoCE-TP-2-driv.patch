+++ b/zig/src/fabric/roce_linux.zig
@@ -0,0 +1,108 @@
+//! Linux ConnectX-7 dual-rail RoCE TP=2 fabric driver using libibverbs.
+const std = @import(std);
+const builtin = @import(builtin);
+
+pub const RoceCtx = anyopaque;
+
+pub const RoceError = error{
+    RoceLayoutFailed,
+    RoceCreateFailed,
+    RoceConnectFailed,
+    RoceStartFailed,
+    RoceProxyFailed,
+    CudaHostAllocFailed,
+};
+
+extern "c" fn roce_abi_version() c_int;
+extern "c" fn roce_blob_bytes() u64;
+extern "c" fn roce_layout(world: c_int, slot_bytes: u64, out: [*]u64) c_int;
+extern "c" fn roce_create(
+    world: c_int,
+    rank: c_int,
+    hca_names: [*]const [*:0]const u8,
+    n_hca: c_int,
+    gid_index: [*]const c_int,
+    traffic_class: c_int,
+    region: *anyopaque,
+    region_bytes: u64,
+    slot_bytes: u64,
+    err: [*]u8,
+    err_len: u64,
+) ?*RoceCtx;
+extern "c" fn roce_local_blob(c_ctx: *RoceCtx, out: [*]u8, out_len: u64) c_int;
+extern "c" fn roce_connect(c_ctx: *RoceCtx, blobs: [*]const u8, blobs_len: u64) c_int;
+extern "c" fn roce_start(c_ctx: *RoceCtx) c_int;
+extern "c" fn roce_stop(c_ctx: *RoceCtx) void;
+extern "c" fn roce_failed(c_ctx: *RoceCtx) c_int;
+extern "c" fn roce_error(c_ctx: *RoceCtx) [*:0]const u8;
+extern "c" fn roce_destroy(c_ctx: ?*RoceCtx) void;
+
+extern "c" fn cudaHostAlloc(pHost: *?*anyopaque, size: usize, flags: c_uint) c_int;
+extern "c" fn cudaFreeHost(pHost: ?*anyopaque) c_int;
+
+const cudaHostAllocPortable: c_uint = 0x01;
+const cudaHostAllocMapped: c_uint = 0x02;
+
+pub const RoceChannel = struct {
+    ctx: *RoceCtx,
+    host_ptr: *anyopaque,
+    total_bytes: u64,
+    slot_bytes: u64,
+    recv_off: u64,
+    flag_off: u64,
+    send_off: u64,
+    ctrl_off: u64,
+    flag_stride: c_int,
+    slots: c_int,
+    rank: c_int,
+    world: c_int,
+
+    pub fn init(rank: c_int, world: c_int, slot_bytes: u64) RoceError!RoceChannel {
+        var layout: [7]u64 = undefined;
+        if (roce_layout(world, slot_bytes, &layout) != 0) return error.RoceLayoutFailed;
+        const total_bytes = layout[4];
+        var host_ptr: ?*anyopaque = null;
+        if (cudaHostAlloc(&host_ptr, total_bytes, cudaHostAllocPortable | cudaHostAllocMapped) != 0) {
+            return error.CudaHostAllocFailed;
+        }
+        const host_mem: [*]u8 = @ptrCast(host_ptr.?);
+        @memset(host_mem[0..total_bytes], 0);
+        const hcas = [_][*:0]const u8{ "rocep1s0f0", "roceP2p1s0f0" };
+        const gids = [_]c_int{ 3, 3 };
+        var err_buf: [512]u8 = undefined;
+        @memset(&err_buf, 0);
+        const ctx = roce_create(
+            world,
+            rank,
+            &hcas,
+            2,
+            &gids,
+            0,
+            host_ptr.?,
+            total_bytes,
+            slot_bytes,
+            &err_buf,
+            err_buf.len,
+        ) orelse return error.RoceCreateFailed;
+        return .{
+            .ctx = ctx,
+            .host_ptr = host_ptr.?,
+            .total_bytes = total_bytes,
+            .slot_bytes = slot_bytes,
+            .recv_off = layout[0],
+            .flag_off = layout[1],
+            .send_off = layout[2],
+            .ctrl_off = layout[3],
+            .flag_stride = @intCast(layout[5]),
+            .slots = @intCast(layout[6]),
+            .rank = rank,
+            .world = world,
+        };
+    }
+
+    pub fn deinit(self: *RoceChannel) void {
+        roce_stop(self.ctx);
+        roce_destroy(self.ctx);
+        _ = cudaFreeHost(self.host_ptr);
+    }
+};
diff --git a/zig/src/native/cuda_roce.cu b/zig/src/native/cuda_roce.cu
new file mode 100644
index 0000000..531f779
--- /dev/null
+++ b/zig/src/native/cuda_roce.cu
@@ -0,0 +1,129 @@
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+namespace {
+
+__device__ __forceinline__ uint32_t ld_relaxed_gpu(const uint32_t* p) {
+    uint32_t v;
+    asm volatile("ld.relaxed.gpu.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+    return v;
+}
+
+__device__ __forceinline__ uint32_t ld_relaxed_sys(const uint32_t* p) {
+    uint32_t v;
+    asm volatile("ld.relaxed.sys.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+    return v;
+}
+
+__device__ __forceinline__ uint32_t ld_acquire_sys(const uint32_t* p) {
+    uint32_t v;
+    asm volatile("ld.acquire.sys.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+    return v;
+}
+
+__device__ __forceinline__ uint4 ld_relaxed_sys_v4(const uint4* p) {
+    uint4 v;
+    asm volatile("ld.relaxed.sys.global.v4.u32 {%0, %1, %2, %3}, [%4];"
+                 : "=r"(v.x), "=r"(v.y), "=r"(v.z), "=r"(v.w) : "l"(p) : "memory");
+    return v;
+}
+
+__device__ __forceinline__ void st_relaxed_sys(uint32_t* p, uint32_t v) {
+    asm volatile("st.relaxed.sys.global.u32 [%0], %1;" ::"l"(p), "r"(v) : "memory");
+}
+
+__device__ __forceinline__ void st_release_gpu(uint32_t* p, uint32_t v) {
+    asm volatile("st.release.gpu.global.u32 [%0], %1;" ::"l"(p), "r"(v) : "memory");
+}
+
+__device__ __forceinline__ uint32_t atom_add_relaxed_gpu(uint32_t* p, uint32_t v) {
+    uint32_t old;
+    asm volatile("atom.relaxed.gpu.global.add.u32 %0, [%1], %2;" : "=r"(old) : "l"(p), "r"(v) : "memory");
+    return old;
+}
+
+__device__ __forceinline__ void fence_sc_sys() { asm volatile("fence.sc.sys;" ::: "memory"); }
+__device__ __forceinline__ void fence_sc_gpu() { asm volatile("fence.sc.gpu;" ::: "memory"); }
+
+constexpr int C_SEQ = 0, C_NBYTES = 1, C_ERROR = 2, C_PEER = 3, C_SLOT_NBYTES = 4, C_HCA = 6;
+
+__global__ void gather_kernel(const uint4* __restrict__ in, uint4* __restrict__ out, int shard_packs, uint32_t nbytes,
+                              int row_packs, char* recv_base, char* flag_base, char* send_base, uint32_t* ctrl,
+                              long long slot_bytes, uint32_t* epoch, uint32_t* stage_ctr, uint32_t* tail_ctr,
+                              uint32_t* poison, uint32_t spin_limit, int world, int rank, int slots, int flag_stride,
+                              int n_hca) {
+    const int tid = threadIdx.x;
+    const uint32_t seq = ld_relaxed_gpu(epoch) + 1u;
+    const uint32_t slot = seq & 1u;
+    uint4* send_slot = reinterpret_cast<uint4*>(send_base + (long long)slot * slot_bytes);
+    const int index = blockIdx.x * blockDim.x + tid, stride = gridDim.x * blockDim.x;
+    if (ld_relaxed_gpu(poison) != 0u) return;
+    for (int i = index; i < shard_packs; i += stride) send_slot[i] = in[i];
+    __syncthreads();
+    if (tid == 0) {
+        fence_sc_sys();
+        const uint32_t prior = atom_add_relaxed_gpu(stage_ctr, 1u);
+        if ((prior + 1u) % gridDim.x == 0u) {
+            st_relaxed_sys(ctrl + C_NBYTES, nbytes);
+            st_relaxed_sys(ctrl + C_SLOT_NBYTES + slot, nbytes);
+            fence_sc_sys();
+            st_relaxed_sys(ctrl + C_SEQ, seq);
+        }
+    }
+    if (tid < world * n_hca) {
+        const int peer = tid / n_hca, hca = tid - peer * n_hca;
+        if (peer != rank) {
+            const uint32_t* flag = reinterpret_cast<const uint32_t*>(
+                flag_base + (((long long)peer * slots + slot) * n_hca + hca) * flag_stride);
+            uint32_t polls = 0;
+            while (ld_acquire_sys(flag) != seq) {
+                if (++polls >= spin_limit) {
+                    st_relaxed_sys(ctrl + C_PEER, (uint32_t)peer);
+                    st_relaxed_sys(ctrl + C_HCA, (uint32_t)hca);
+                    st_relaxed_sys(ctrl + C_ERROR, seq);
+                    st_release_gpu(poison, seq);
+                    break;
+                }
+            }
+        }
+    }
+    __syncthreads();
+    if (ld_relaxed_gpu(poison) == 0u) {
+        const int out_row_packs = world * row_packs;
+        for (int source = 0; source < world; ++source) {
+            const uint4* peer_slot = reinterpret_cast<const uint4*>(
+                recv_base + ((long long)source * slots + slot) * slot_bytes);
+            for (int i = index; i < shard_packs; i += stride) {
+                const int row = i / row_packs, col = i - row * row_packs;
+                const uint4 w = source == rank ? in[i] : ld_relaxed_sys_v4(peer_slot + i);
+                out[(long long)row * out_row_packs + (long long)source * row_packs + col] = w;
+            }
+        }
+    }
+    fence_sc_gpu();
+    __syncthreads();
+    if (tid == 0) {
+        const uint32_t prior = atom_add_relaxed_gpu(tail_ctr, 1u);
+        if ((prior + 1u) % gridDim.x == 0u) {
+            fence_sc_gpu();
+            if (ld_relaxed_sys(ctrl + C_ERROR) == 0u) st_release_gpu(epoch, seq);
+        }
+    }
+}
+
+} // namespace
+
+extern "C" int launch_roce_gather(
+    const void* in, void* out, int shard_packs, uint32_t nbytes, int row_packs,
+    void* recv_base, void* flag_base, void* send_base, void* ctrl,
+    long long slot_bytes, void* epoch, void* stage_ctr, void* tail_ctr,
+    void* poison, uint32_t spin_limit, int world, int rank, int slots, int flag_stride,
+    int n_hca, int grid, int threads, void* stream)
+{
+    gather_kernel<<<(unsigned)grid, (unsigned)threads, 0, (cudaStream_t)stream>>>(
+        (const uint4*)in, (uint4*)out, shard_packs, nbytes, row_packs,
+        (char*)recv_base, (char*)flag_base, (char*)send_base, (uint32_t*)ctrl,
+        slot_bytes, (uint32_t*)epoch, (uint32_t*)stage_ctr, (uint32_t*)tail_ctr,
+        (uint32_t*)poison, spin_limit, world, rank, slots, flag_stride, n_hca);
+    return (int)cudaGetLastError();
+}
